# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chave SECRETA (service_role). Usada apenas por scripts locais, como
# scripts/promover-admin.mjs. NUNCA cadastre na Vercel nem no Git.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada no link de confirmação de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Dados da empresa exibidos no rodapé (obrigatório preencher antes de publicar) ---
NEXT_PUBLIC_EMPRESA_NOME=SobreImpréstimos
NEXT_PUBLIC_EMPRESA_CNPJ=
NEXT_PUBLIC_INSTITUICAO_PARCEIRA=Nome da instituição financeira parceira autorizada pelo Banco Central

# Taxa de juros MENSAL usada no simulador (0.0399 = 3,99% a.m.).
# Deve ser a taxa real e legal do produto (da instituição parceira autorizada).
# O painel admin recusa taxas acima de 20% a.m. como limite do produto.
# Esse limite não equivale a uma definição de teto legal.
NEXT_PUBLIC_TAXA_MENSAL=0.0399

# --- Provedor de conta digital / PIX (Banking as a Service) ---
# "demo" = nenhuma movimentação real; "parceiro" = usa lib/banking/partner.ts
BAAS_PROVIDER=demo
BAAS_API_URL=
BAAS_API_KEY=

# Canal real para solicitações de privacidade (exibido na política).
NEXT_PUBLIC_PRIVACIDADE_EMAIL=
